# ── Database ────────────────────────────────────────────────
# Local development uses Prisma's bundled Postgres:
#   npm run db:start          # starts it
#   npx prisma dev ls         # prints the connection details
#
# Use the *TCP* URL it prints, not the prisma+postgres:// one — Prisma 7's
# driver adapter talks to Postgres through the `pg` driver, which needs a
# standard connection string. It typically looks like:
#   DATABASE_URL="postgres://postgres:postgres@localhost:51218/template1?sslmode=disable"
#
# The same variable works unchanged against any hosted Postgres in production
# (Neon, Supabase, RDS):
#   DATABASE_URL="postgresql://user:password@host:5432/chikitsa"
DATABASE_URL=""

# ── Auth ────────────────────────────────────────────────────
# Signs the session JWT. Generate a fresh one per environment:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=""

# ── AI (optional) ───────────────────────────────────────────
# Powers the Ayurveda assistant, symptom triage, and protocol drafting.
# Leave blank to run those features in demo mode with scripted responses —
# the app stays fully functional either way.
ANTHROPIC_API_KEY=""
